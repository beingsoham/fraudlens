{
  "name": "fraudlens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FraudLens - real-time UPI-style transaction risk monitoring and investigation platform",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @fraudlens/api",
    "dev:web": "npm run dev --workspace @fraudlens/web",
    "build": "npm run build --workspace @fraudlens/web",
    "start": "npm run start --workspace @fraudlens/api",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:reset": "prisma migrate reset --force --schema prisma/schema.prisma",
    "prisma:status": "prisma migrate status --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "seed": "node prisma/seed.js",
    "test": "npm-run-all test:api test:web",
    "test:api": "npm run test --workspace @fraudlens/api",
    "test:api:unit": "npm run test:unit --workspace @fraudlens/api",
    "test:api:integration": "npm run test:integration --workspace @fraudlens/api",
    "test:web": "npm run test --workspace @fraudlens/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md,yml,yaml}\"",
    "verify": "npm-run-all lint format:check test build"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
