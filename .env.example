# ---------------------------------------------------------------------------
# FraudLens environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit a real `.env` file or real secrets to source control.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# Port the Express API listens on
PORT=4000
# Log level for the structured logger: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------
# Primary application database. PostgreSQL only.
DATABASE_URL=postgresql://fraudlens:fraudlens@localhost:5433/fraudlens?schema=public
# Separate database used by the integration test suite. MUST NOT be the dev DB.
TEST_DATABASE_URL=postgresql://fraudlens:fraudlens@localhost:5433/fraudlens_test?schema=public

# --- Authentication --------------------------------------------------------
# Secret used to sign JWTs. Generate with: openssl rand -base64 48
# Minimum 32 characters. The API refuses to start in production with the placeholder.
JWT_SECRET=replace-me-with-a-long-random-development-secret-value
# Access token lifetime (zeit/ms format, e.g. 15m, 2h, 7d)
JWT_EXPIRES_IN=12h
# Secret used to sign the CSRF double-submit cookie. Generate separately.
COOKIE_SECRET=replace-me-with-a-second-long-random-development-secret
# Name of the httpOnly session cookie
AUTH_COOKIE_NAME=fraudlens_session

# --- CORS / frontend -------------------------------------------------------
# Comma-separated list of allowed browser origins for CORS and Socket.IO
WEB_ORIGIN=http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=1200
# Maximum accepted JSON request body size
REQUEST_BODY_LIMIT=256kb

# --- Seed / demo data ------------------------------------------------------
# When true, `npm run seed` also generates a synthetic transaction history so
# the dashboards have data to display locally. Set to false for an empty DB
# containing only users and the default ruleset.
SEED_DEMO_DATA=true
# Number of synthetic accounts and transactions generated by the seed script
SEED_ACCOUNT_COUNT=40
SEED_TRANSACTION_COUNT=1200
# Deterministic seed for the generator so local data is reproducible
SEED_RANDOM_SEED=20260101
# Local development accounts created by the seed script. Change the passwords.
SEED_ADMIN_EMAIL=admin@fraudlens.local
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
SEED_ANALYST_EMAIL=analyst@fraudlens.local
SEED_ANALYST_PASSWORD=ChangeMe!Analyst123
SEED_INVESTIGATOR_EMAIL=investigator@fraudlens.local
SEED_INVESTIGATOR_PASSWORD=ChangeMe!Investigator123
SEED_VIEWER_EMAIL=viewer@fraudlens.local
SEED_VIEWER_PASSWORD=ChangeMe!Viewer123

# --- Transaction simulator -------------------------------------------------
# Default transactions-per-second when the simulator is started without a rate
SIMULATOR_DEFAULT_RATE=2
# Hard upper bound the API enforces on the requested rate
SIMULATOR_MAX_RATE=25
# Default deterministic RNG seed for the simulator
SIMULATOR_DEFAULT_SEED=424242
# Start the simulator automatically when the API boots (development only)
SIMULATOR_AUTOSTART=false

# --- Fraud risk thresholds (initial engineering defaults) ------------------
# Scores 0..RISK_MEDIUM_THRESHOLD-1 are Low, up to RISK_HIGH_THRESHOLD-1 are
# Medium, and RISK_HIGH_THRESHOLD..100 are High. Must satisfy
# 0 < RISK_MEDIUM_THRESHOLD < RISK_HIGH_THRESHOLD <= 100.
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=70
# Minimum risk score that causes an alert to be created
ALERT_THRESHOLD=70
# Version string recorded on every risk assessment
RULESET_VERSION=2026.10.1
